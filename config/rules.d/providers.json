        "structured_estimate_lendable": ["actual", "previous", "unit", "actual_ingested_at"],
        "note_headline_metrics": "Per event_class, ordered name patterns (case-insensitive regex) choosing the metric whose consensus/actual the kept row carries as its scalar values (surprise direction, MACRO_RELEASE, alerts). Without a match a lone metric is used; several unmatched metrics are listed in metrics only (never guessed).",
        "headline_metrics": {
          "US_CPI": ["core (cpi|inflation rate).*m/?o/?m", "\\bcpi\\b.*m/?o/?m", "inflation rate.*m/?o/?m", "\\bcpi\\b.*y/?o/?y", "inflation rate.*y/?o/?y", "\\bcpi\\b"],
          "US_PCE": ["core pce.*m/?o/?m", "pce.*m/?o/?m", "core pce.*y/?o/?y", "pce.*y/?o/?y", "\\bpce\\b"],
          "US_PPI": ["core ppi.*m/?o/?m", "\\bppi\\b.*m/?o/?m", "\\bppi\\b.*y/?o/?y", "\\bppi\\b"],
          "US_NFP": ["non ?farm payrolls"],
          "note_US_NFP": "Payrolls only. The unemployment rate and average hourly earnings stay in the row's metrics but never become its scalar consensus/actual: the labour template reads 'above consensus' as a stronger labour market, and a HIGHER unemployment rate is a weaker one (rate 4.2 vs consensus 4.1 was resolved as 'Stronger than consensus').",
          "US_GDP": ["gdp growth rate.*q/?o/?q", "\\bgdp\\b.*q/?o/?q", "\\bgdp\\b"],
          "US_RETAIL_SALES": ["^retail sales.*m/?o/?m", "retail sales"],
          "US_CLAIMS": ["initial jobless claims"],
          "US_JOLTS": ["job openings", "jolts"],
          "US_ISM": ["\\bism\\b.*pmi", "\\bism\\b"],
          "UMICH": ["consumer sentiment", "michigan"],
          "CONF_BOARD": ["consumer confidence"],
          "FOMC": ["interest rate decision"],
          "ECB": ["deposit facility rate", "interest rate decision"],
          "BOE": ["interest rate decision", "bank rate"],
          "BOJ": ["interest rate decision"]
        }
      },
