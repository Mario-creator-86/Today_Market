    "edgar_fts": {
      "base_url": "https://efts.sec.gov",
      "search_path": "/LATEST/search-index",
      "archive_url": "https://www.sec.gov",
      "user_agent_env": "SEC_USER_AGENT",
      "poll_seconds": 900,
      "timeout_seconds": 20,
      "rate_limit": {"documented": "SEC fair access: max 10 requests/second, declared User-Agent with contact email",
