      {"source_id": "sec-filings", "timezone": "America/New_York"}
    ],
    "date_only_documents_note": "Sources whose pages give a publication date and no clock time (OFAC Recent Actions; EDGAR full-text hits carry file_date only). Their adapters stamp such a document at the start of that day in the time zone given here, so a stamp at exactly 00:00:00 there means 'time not published': the document and its event are stored and served with time_known false and the date (published_date / event_date). The stamp is kept only to order and age the publication; it is never a clock time to show. Documents of the same sources that carry a real time (EDGAR acceptance time, SLS publication time) are not affected.",
    "gdelt": {
      "base_url": "https://data.gdeltproject.org",
      "lastupdate_path": "/gdeltv2/lastupdate.txt",
      "poll_seconds": 900,
      "timeout_seconds": 30,
      "rate_limit": {"documented": "none published for the raw files; poll the 15-minute batch once",
                     "min_interval_seconds": 2, "max_calls": 12, "per_seconds": 900},
      "fallback_batches": 4,
      "max_zip_bytes": 5000000,
      "max_csv_bytes": 50000000,
      "delay_label": "15-minute batch (GDELT machine-coded news events)",
