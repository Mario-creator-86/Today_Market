      "priority": "MEDIUM",
      "high_priority": "HIGH"
    },
    "event": {
      "note": "1.5.0 (AFP-04): EVENT alerts are sent for newly CONFIRMED events (notifications.event_alerts): status in statuses, ASSESSED importance >= min_importance (an importance that was never assessed gives no alert and no AI request), an identified asset impact when require_assets is true (the event's own affected assets, else the assets its causal trigger reaches), and first seen or last updated within max_age_hours, so a restart does not alert the whole backlog. Each event alerts once: the alert id is the event id (the former key was the shared status, which allowed one EVENT alert per day in total).",
      "statuses": [
        "CONFIRMED"
      ],
      "min_importance": 0.5,
      "high_importance": 0.8,
      "require_assets": true,
      "max_age_hours": 24,
      "priority": "MEDIUM",
      "high_priority": "HIGH"
    },
    "macro_release": {
