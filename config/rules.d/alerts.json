{
  "alerts_version": "1.5.0",
  "alerts": {
    "note": "Driver thresholds use the driver's own unit (bp for yields, percent otherwise). pressure is the expected sign of the asset move when the driver rises.",
    "priorities": [
      "LOW",
      "MEDIUM",
      "HIGH"
    ],
    "cooldown_seconds": {
