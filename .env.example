# Copy to .env and fill in what you have. Never commit .env. Providers without credentials show NOT CONFIGURED.
# Every Settings field (backend/config.py, notifications.py, telemetry.py, workers.py) is listed with its default.

# --- core -------------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./market_hub.db
# Redis enables Redis Streams (event bus) and Celery; empty = local in-process mode.
REDIS_URL=
# Administrative writes (/api/admin/*) are disabled until this is set.
ADMIN_TOKEN=
# local = no password when the app is opened on this computer (default); token = require ADMIN_TOKEN (servers, Docker).
ADMIN_AUTH=local
ENABLE_INGESTION=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
POSTGRES_PASSWORD=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# live | stub (stub runs paid adapters against labelled DEVELOPMENT STUB fixtures when a key is absent)
PROVIDER_MODE=live

# --- AI -----------------------------------------------------------------------------------------
# ollama | openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
SEARCH_HOURLY_BUDGET=60
SEARCH_TOPIC_COOLDOWN=60
MAX_DOCUMENT_CHARS=40000
# Largest accepted HTTP request body (bytes); larger requests get 413.
MAX_REQUEST_BYTES=1000000

# --- data providers -----------------------------------------------------------------------------
MASSIVE_API_KEY=
X_BEARER_TOKEN=
# The X watch query is built from x_accounts and x_monitoring in config/rules.d/sources.json.
FMP_API_KEY=
REUTERS_BASE_URL=
REUTERS_API_KEY=
AP_BASE_URL=
AP_API_KEY=
# SEC EDGAR and the BLS release schedule: your name or company and a real contact e-mail, e.g.
# "Jane Doe jane.doe@yourdomain.com". Empty = NOT CONFIGURED; example.com addresses are rejected.
SEC_USER_AGENT=
# The SEC CIK watchlist is provider_routing.sec.cik_watchlist in config/rules.d/providers.json.
# api.congress.gov (free api.data.gov key)
CONGRESS_API_KEY=
# Free keys (register yourself; adapters stay NOT CONFIGURED when empty):
# FRED/ALFRED (fred.stlouisfed.org/docs/api/api_key.html): credit spread BAA10Y, Fed target range, vintage macro history.
FRED_API_KEY=
# Finnhub (finnhub.io, personal use): real-time quotes for the ten tracked US equities.
FINNHUB_API_KEY=
# BLS registered key (optional): raises the BLS API budget from 25 to 500 queries/day.
BLS_API_KEY=
# Alpaca Market Data (alpaca.markets, free paper account; personal use, no redistribution). Use a PAPER key pair:
# the app only reads data.alpaca.markets (IEX real-time snapshots for ETF proxies and equity fallback, daily bars,
# Benzinga news) and never calls trading endpoints. IEX is a single exchange, not the consolidated tape.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- cadences and freshness: polling cadences live in config/rules.d/refresh.json -----------------
ANALYSIS_SECONDS=300
QUOTE_STALE_SECONDS=15
# Evidence age windows per event type live in config/rules.d/verification.json.
MAX_FUTURE_SECONDS=5

# --- background jobs -----------------------------------------------------------------------------
# true: Celery beat owns polling/analysis schedules (requires REDIS_URL); false: in-process asyncio runtime.
CELERY_ENABLED=false
# Defaults to REDIS_URL when empty.
CELERY_BROKER_URL=

# --- observability -------------------------------------------------------------------------------
LOG_LEVEL=INFO
# json | text (both redact API keys, tokens and configured secrets)
LOG_FORMAT=json
# Spans are exported only when this is set and `pip install .[otel]` was run, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=market-intelligence-hub

# --- alert delivery (in-app alerts always work; these channels stay NOT CONFIGURED when empty) -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipients
SMTP_TO=
SMTP_STARTTLS=true
SMTP_SSL=false
# Web Push (VAPID). Generate a key pair with `vapid --gen` (py-vapid) and `pip install .[notifications]`.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
# mailto:you@example.com or an https contact URL
WEBPUSH_SUBJECT=
